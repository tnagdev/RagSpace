# Chat Manager Service Configuration

# Service Settings
SERVICE_NAME=chat-manager
SERVICE_PORT=3005
LOG_LEVEL=INFO
MODE=development

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chat_manager?schema=chat_manager
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/chat_manager?schema=chat_manager

# LLM Configuration (NVIDIA API)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.3-70b-instruct
MAX_TOKENS=1024
TEMPERATURE=0.7

# Context Window Management
MAX_CONTEXT_TOKENS=4000
MAX_MESSAGES_IN_CONTEXT=20

# External Service URLs
FILE_EMBEDDER_URL=http://localhost:8003
UPLOAD_MANAGER_URL=http://localhost:3002
SCENE_DETECTOR_URL=http://localhost:3003

# Conversation Settings
MAX_CONVERSATION_HISTORY=10
CONTEXT_WINDOW_SIZE=5
