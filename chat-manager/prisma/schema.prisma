generator client {
    provider        = "prisma-client-py"
    interface       = "asyncio"
    previewFeatures = ["multiSchema"]
}

datasource db {
    provider = "postgresql"
    schemas  = ["chat_manager"]
    url      = env("DIRECT_URL")
}

model Conversation {
    id        String    @id @default(uuid())
    userId    String
    title     String?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    messages  Message[]

    @@index([userId])
    @@index([createdAt])
    @@schema("chat_manager")
}

model Message {
    id             String       @id @default(uuid())
    conversationId String
    conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    role           String // 'user' or 'assistant'
    content        String       @db.Text
    timestamp      DateTime     @default(now())
    searchResults  Json? // Store search results metadata
    fileIds        String[] // Array of file IDs used in search

    @@index([conversationId])
    @@index([timestamp])
    @@schema("chat_manager")
}
