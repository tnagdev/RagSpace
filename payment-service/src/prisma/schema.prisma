generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum PlanType {
    FREE
    BASIC
    PRO
}

enum PlanInterval {
    MONTHLY
    YEARLY
}

enum SubscriptionStatus {
    ACTIVE
    CANCELLED
    EXPIRED
    PAST_DUE
    PAUSED
    TRIALING
}

enum UsageMetricType {
    CONVERSATIONS
    STORAGE
    FILE_CONVERSATIONS
    YOUTUBE_VIDEOS
    MAX_VIDEO_LENGTH
}

model Plan {
    id          String       @id @default(uuid())
    name        String
    description String?
    type        PlanType     @unique
    interval    PlanInterval
    price       Float
    priceUnit   String       @default("USD")
    isActive    Boolean      @default(true)

    // Lemon Squeezy Integration
    lemonSqueezyVariantId String? @unique
    lemonSqueezyProductId String?

    // Plan limits configuration (flexible JSON for scalability)
    limits Json @default("{}")

    // Features
    features String[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    subscriptions Subscription[]

    @@map("plans")
}

model Subscription {
    id     String             @id @default(uuid())
    userId String
    planId String
    status SubscriptionStatus @default(ACTIVE)

    // Lemon Squeezy Integration
    lemonSqueezySubscriptionId String? @unique
    lemonSqueezyCustomerId     String?
    lemonSqueezyOrderId        String?

    // Subscription details
    currentPeriodStart DateTime
    currentPeriodEnd   DateTime
    cancelAtPeriodEnd  Boolean   @default(false)
    canceledAt         DateTime?
    trialStart         DateTime?
    trialEnd           DateTime?

    // Payment details
    lastPaymentDate DateTime?
    nextPaymentDate DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    plan         Plan          @relation(fields: [planId], references: [id])
    usageRecords UsageRecord[]
    usageQuotas  UsageQuota[]

    @@index([userId])
    @@index([status])
    @@map("subscriptions")
}

model UsageQuota {
    id             String          @id @default(uuid())
    subscriptionId String
    metricType     UsageMetricType

    // Quota configuration
    limit   Int       @default(0) // 0 means unlimited
    used    Int       @default(0)
    resetAt DateTime? // For monthly/weekly resets

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

    @@unique([subscriptionId, metricType])
    @@index([subscriptionId])
    @@map("usage_quotas")
}

model UsageRecord {
    id             String          @id @default(uuid())
    userId         String
    subscriptionId String
    metricType     UsageMetricType

    // Usage details
    amount   Int   @default(1)
    metadata Json? // Additional context (fileId, conversationId, etc.)

    // Request information
    endpoint  String?
    ipAddress String?
    userAgent String?

    timestamp DateTime @default(now())

    subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([subscriptionId])
    @@index([metricType])
    @@index([timestamp])
    @@map("usage_records")
}

model WebhookEvent {
    id             String    @id @default(uuid())
    eventType      String
    lemonSqueezyId String    @unique
    payload        Json
    processed      Boolean   @default(false)
    processedAt    DateTime?
    error          String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([processed])
    @@index([eventType])
    @@map("webhook_events")
}

model PaymentHistory {
    id             String  @id @default(uuid())
    userId         String
    subscriptionId String?

    // Payment details
    amount   Float
    currency String @default("USD")
    status   String

    // Lemon Squeezy details
    lemonSqueezyOrderId   String? @unique
    lemonSqueezyInvoiceId String?

    // Additional information
    description String?
    metadata    Json?

    paidAt    DateTime?
    createdAt DateTime  @default(now())

    @@index([userId])
    @@index([subscriptionId])
    @@map("payment_history")
}
