# Application
PORT=3003
NODE_ENV=development

# Services
UPLOAD_MANAGER_URL=http://localhost:3002

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scene_detector

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=file.events
RABBITMQ_QUEUE=scene.detector.queue

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=your_bucket_name
AWS_S3_ENDPOINT=http://localhost:9000  # For MinIO

# Scene Detection
SCENE_DETECTION_THRESHOLD=27.0
SCENE_DETECTION_MIN_SCENE_LENGTH=15
THUMBNAIL_WIDTH=1280
THUMBNAIL_HEIGHT=720
THUMBNAIL_QUALITY=85

# Processing
TEMP_DIR=/tmp/scene-detector
MAX_CONCURRENT_JOBS=2
