{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "UpdateFileStatusParams",
  "title": "UpdateFileStatusParams",
  "description": "Partial file update payload sent to upload-manager PUT /upload/:fileId.",
  "type": "object",
  "properties": {
    "filename":               { "type": ["string", "null"] },
    "originalFilename":       { "type": ["string", "null"] },
    "fileSize":               { "type": ["integer", "null"] },
    "processingStatus":       { "type": ["string", "null"] },
    "processingStage":        { "type": ["string", "null"] },
    "metadata":               { "type": ["object", "null"] },
    "errorMessage":           { "type": ["string", "null"] },
    "processingRetryCount":   { "type": ["integer", "null"] },
    "processingStartedAt":    { "type": ["string", "null"] },
    "processingCompletedAt":  { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
