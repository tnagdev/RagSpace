{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "UploadedFile",
  "title": "UploadedFile",
  "description": "File record returned by the upload-manager service.",
  "type": "object",
  "required": ["id", "userId", "filename", "originalFilename", "fileSize", "mimeType", "fileType", "s3Key", "s3Bucket", "s3Url", "uploadStatus", "processingStatus", "processingStage"],
  "properties": {
    "id":                     { "type": "string" },
    "userId":                 { "type": "string" },
    "filename":               { "type": "string" },
    "originalFilename":       { "type": "string" },
    "fileSize":               { "type": "integer" },
    "mimeType":               { "type": "string" },
    "fileType":               { "$ref": "../enums/FileType.json" },
    "s3Key":                  { "type": "string" },
    "s3Bucket":               { "type": "string" },
    "s3Url":                  { "type": "string" },
    "thumbnailPath":          { "type": ["string", "null"] },
    "youtubeUrl":             { "type": ["string", "null"] },
    "uploadStatus":           { "type": "string" },
    "processingStatus":       { "$ref": "../enums/ProcessingStatus.json" },
    "processingStage":        { "$ref": "../enums/ProcessingStage.json" },
    "metadata":               { "type": ["object", "null"] },
    "errorMessage":           { "type": ["string", "null"] },
    "processingRetryCount":   { "type": "integer" },
    "uploadedAt":             { "type": ["string", "null"] },
    "processingStartedAt":    { "type": ["string", "null"] },
    "processingCompletedAt":  { "type": ["string", "null"] },
    "createdAt":              { "type": "string" },
    "updatedAt":              { "type": "string" }
  },
  "additionalProperties": false
}
