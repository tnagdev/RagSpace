generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    schemas  = ["upload"]
}

enum FileType {
    IMAGE
    VIDEO
    AUDIO
    DOCUMENT
    YOUTUBE_VIDEO
    OTHER

    @@schema("upload")
}

enum UploadStatus {
    PENDING
    UPLOADING
    COMPLETED
    FAILED
    CANCELLED

    @@schema("upload")
}

enum ProcessingStatus {
    NOT_STARTED
    IN_PROGRESS
    COMPLETED
    FAILED
    SKIPPED

    @@schema("upload")
}

enum ProcessingStage {
    UPLOAD
    EMBEDDING
    SCENE_DETECTION
    INDEXING
    COMPLETED

    @@schema("upload")
}

enum MetadataSourceType {
    IMAGE
    VIDEO
    SCENE

    @@schema("upload")
}

model FileMetadata {
    id          String             @id @default(uuid())
    fileId      String
    sceneId     String?
    sourceType  MetadataSourceType
    summary     String?
    objects     String[]
    setting     String?
    style       String?
    colors      String[]
    rawResponse Json?
    createdAt   DateTime           @default(now())
    updatedAt   DateTime           @updatedAt

    file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

    @@unique([fileId, sceneId])
    @@index([fileId])
    @@index([sceneId])
    @@index([sourceType])
    @@map("file_metadata")
    @@schema("upload")
}

model Collection {
    id          String   @id @default(uuid())
    userId      String
    name        String
    description String?
    color       String?
    parentId    String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    parent          Collection?      @relation("CollectionHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
    children        Collection[]     @relation("CollectionHierarchy")
    fileCollections FileCollection[]

    @@index([userId])
    @@index([parentId])
    @@index([createdAt])
    @@map("collections")
    @@schema("upload")
}

model FileCollection {
    id           String   @id @default(uuid())
    fileId       String
    collectionId String
    addedAt      DateTime @default(now())

    file       File       @relation(fields: [fileId], references: [id], onDelete: Cascade)
    collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

    @@unique([fileId, collectionId])
    @@index([fileId])
    @@index([collectionId])
    @@map("file_collections")
    @@schema("upload")
}

model File {
    id                    String           @id @default(uuid())
    userId                String
    filename              String
    originalFilename      String
    fileSize              Int
    mimeType              String
    fileType              FileType
    s3Key                 String           @unique
    s3Bucket              String
    s3Url                 String?
    thumbnailPath         String?
    youtubeUrl            String?
    uploadStatus          UploadStatus     @default(PENDING)
    processingStatus      ProcessingStatus @default(NOT_STARTED)
    processingStage       ProcessingStage  @default(UPLOAD)
    metadata              Json?
    errorMessage          String?
    processingRetryCount  Int              @default(0)
    uploadedAt            DateTime?
    processingStartedAt   DateTime?
    processingCompletedAt DateTime?
    createdAt             DateTime         @default(now())
    updatedAt             DateTime         @updatedAt

    fileMetadata    FileMetadata[]
    fileCollections FileCollection[]

    @@index([userId])
    @@index([uploadStatus])
    @@index([processingStatus])
    @@index([createdAt])
    @@map("files")
    @@schema("upload")
}
