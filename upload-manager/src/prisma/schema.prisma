generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    schemas  = ["upload"]
}

enum FileType {
    IMAGE
    VIDEO
    AUDIO
    DOCUMENT
    OTHER

    @@schema("upload")
}

enum UploadStatus {
    PENDING
    UPLOADING
    COMPLETED
    FAILED
    CANCELLED

    @@schema("upload")
}

enum ProcessingStatus {
    NOT_STARTED
    IN_PROGRESS
    COMPLETED
    FAILED
    SKIPPED

    @@schema("upload")
}

enum ProcessingStage {
    UPLOAD
    EMBEDDING
    SCENE_DETECTION
    INDEXING
    COMPLETED

    @@schema("upload")
}

model File {
    id                    String           @id @default(uuid())
    userId                String
    filename              String
    originalFilename      String
    fileSize              Int
    mimeType              String
    fileType              FileType
    s3Key                 String           @unique
    s3Bucket              String
    s3Url                 String?
    uploadStatus          UploadStatus     @default(PENDING)
    processingStatus      ProcessingStatus @default(NOT_STARTED)
    processingStage       ProcessingStage  @default(UPLOAD)
    metadata              Json?
    errorMessage          String?
    uploadedAt            DateTime?
    processingStartedAt   DateTime?
    processingCompletedAt DateTime?
    createdAt             DateTime         @default(now())
    updatedAt             DateTime         @updatedAt

    @@index([userId])
    @@index([uploadStatus])
    @@index([processingStatus])
    @@index([createdAt])
    @@map("files")
    @@schema("upload")
}
