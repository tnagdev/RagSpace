# API Gateway Environment Configuration

# Server Configuration
PORT=8000
HOST=localhost
NODE_ENV=development

# Database Configuration (for session validation)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ragspace?pgbouncer=true
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ragspace

# Better Auth Configuration
BETTER_AUTH_SECRET=your-secret-key-change-this-in-production

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_TTL=60          # Time window in seconds
RATE_LIMIT_MAX=100         # Max requests per window per user

# Microservice URLs
AUTH_SERVICE_URL=http://localhost:8001
UPLOAD_MANAGER_URL=http://localhost:3002
SCENE_DETECTOR_URL=http://localhost:3003
FILE_EMBEDDER_URL=http://localhost:8003
CHAT_MANAGER_URL=http://localhost:3005
