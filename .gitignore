# ===================================
# Combined .gitignore for RagSpace
# ===================================

# ============== Node.js ==============
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Compiled output
dist/
build/
*.tsbuildinfo
.nest/

# Test coverage
coverage/
.nyc_output/
*.lcov

# Package manager lock files (optional - uncomment if needed)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ============== Python ==============
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
ENV/
.venv/
.pyenv/
pipenv/

# Python distribution / packaging
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
# Python lib folders (but not frontend/src/lib)
**/python*/lib/
**/python*/lib64/
venv/lib/
venv/lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# ============== Databases ==============
# Prisma
*.db
*.db-journal
node_modules/.prisma/

# ChromaDB
chroma_data/
*.chroma

# Database files
*.sqlite
*.sqlite3

# ============== Docker ==============
# Docker volumes and data
docker-compose.override.yml
.docker/

# ============== Environment Variables ==============
.env
.env.*
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.env
*.env.*
.envrc

# ============== IDEs and Editors ==============
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr
.idea_modules/

# Eclipse
.project
.classpath
.c9/
*.launch
.settings/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# ============== Operating Systems ==============
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*
.nfs*

# ============== Logs ==============
logs/
*.log
log/
*.log.*

# ============== Temporary Files ==============
tmp/
temp/
.tmp/
.temp/
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo

# ============== Build Artifacts ==============
out/
target/
*.o
*.obj
*.exe
*.dll
*.dylib

# ============== Media & Large Files ==============
# Uncomment if you don't want to track large media files
# *.mp4
# *.avi
# *.mov
# *.mkv
# *.mp3
# *.wav
# *.flac

# ============== Service-Specific ==============
# Auth service
auth-service/.env
auth-service/dist/
auth-service/node_modules/
auth-service/prisma/migrations/*
!auth-service/prisma/migrations/.gitkeep

# API Gateway
api-gateway/.env
api-gateway/dist/
api-gateway/node_modules/

# Upload Manager
upload-manager/uploads/
upload-manager/temp/

# File Embedder
file-embedder/embeddings/
file-embedder/models/
file-embedder/cache/

# Scene Detector
scene-detector/output/
scene-detector/frames/

# Chat Manager
chat-manager/chat_history/
chat-manager/sessions/

# ============== Misc ==============
# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Lock files
.lock

# Generated files
*.generated.*
# Added by code-review-graph
.code-review-graph/
