{
  "name": "@ragspace/shared-ts",
  "version": "2.0.0",
  "description": "Generated gRPC/event contracts and shared gRPC, event bus and logging runtime for RagSpace TypeScript services.",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "buf generate ../../contracts --template buf.gen.yaml",
    "build": "npm run generate && tsc -p tsconfig.build.json",
    "build:no-gen": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@grpc/grpc-js": "^1.14.5",
    "abort-controller-x": "^0.5.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.9",
    "nice-grpc": "^2.1.17",
    "nice-grpc-common": "^2.0.4",
    "nice-grpc-server-health": "^2.0.20"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^22.10.0",
    "ts-proto": "^2.13.0",
    "typescript": "^5.9.2"
  }
}
